# ── Provider defaults ──────────────────────────────────────────────────────────
# Which provider and models to use by default (can be overridden via CLI flags)

LLM_PROVIDER=gemini
DETECTION_MODEL=gemini-flash-latest
CRITIC_MODEL=gemini-flash-latest

# ── API keys ───────────────────────────────────────────────────────────────────
# Fill in only the key(s) for the provider(s) you intend to use.

# Google Gemini (--llm gemini)
GOOGLE_API_KEY=

# OpenAI (--llm openai)
OPENAI_API_KEY=

# Anthropic (--llm anthropic)
ANTHROPIC_API_KEY=

# OpenRouter — one key for all providers (--llm openrouter)
# Get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Pipeline settings ──────────────────────────────────────────────────────────
MAX_RETRIES=3
TIMEOUT_S=60

# ── Paths ──────────────────────────────────────────────────────────────────────
CATALOG_PATH=smells_catalog.json

# ── Vector DB ──────────────────────────────────────────────────────────────────
# "mock" uses hardcoded examples (PoC). Replace with a real provider when ready.
VECTORDB_PROVIDER=mock
